---
import type {CollectionEntry} from 'astro:content';
interface Props{publication:CollectionEntry<'publications'>;projectId?:string;}
const {publication,projectId}=Astro.props;const p=publication.data;
---
<article class="publication"><div class="meta">{p.venue}{p.highlight&&<> · <span class="highlight">{p.highlight}</span></>}</div><h2>{p.title}</h2>
<div class="authors">{p.authors.map((author,index)=><>{index>0?', ':''}{author==='Zinuo You'?<strong>{author}</strong>:author}</>)}</div><p>{p.summary}</p>
<div class="links">{p.links.map(link=><a href={link.url}>{link.label}</a>)}{projectId&&<a href={`/work/${projectId}/#demo`}>Demo & explanation ↗</a>}</div></article>
