---
const path=Astro.url.pathname;
const links=[{href:'/work/',label:'Research'},{href:'/publications/',label:'Papers'},{href:'/about/',label:'About'}];
---
<header class="site-header"><div class="shell header-inner"><a class="wordmark" href="/">Zinuo You</a><nav aria-label="Main navigation">{links.map(link=><a href={link.href} aria-current={path.startsWith(link.href)?'page':undefined}>{link.label}</a>)}</nav></div></header>
