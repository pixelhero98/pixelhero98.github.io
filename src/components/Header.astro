---
import { siteConfig } from '../config';
const path = Astro.url.pathname;
const links = [
	{ href: '/work/', label: 'Work' },
	{ href: '/publications/', label: 'Publications' },
	{ href: '/about/', label: 'About' },
];
---

<header class="site-header">
	<div class="shell header-inner">
		<a class="wordmark" href="/" aria-label={`${siteConfig.name}, home`}>
			<span class="mark" aria-hidden="true">ZY</span>
			<span>{siteConfig.shortName}</span>
		</a>
		<nav aria-label="Primary navigation">
			{links.map((link) => (
				<a href={link.href} aria-current={path.startsWith(link.href) ? 'page' : undefined}>{link.label}</a>
			))}
			<a class="contact-link" href={`mailto:${siteConfig.email}`}>Email</a>
		</nav>
	</div>
</header>

<style>
	.site-header { position: sticky; top: 0; z-index: 50; border-bottom: 1px solid var(--line); background: rgba(245, 242, 234, 0.88); backdrop-filter: blur(14px); }
	.header-inner { display: flex; align-items: center; justify-content: space-between; min-height: 72px; gap: 24px; }
	.wordmark { display: inline-flex; align-items: center; gap: 11px; font-size: 0.88rem; font-weight: 720; text-decoration: none; }
	.mark { display: grid; place-items: center; width: 34px; aspect-ratio: 1; border-radius: 50%; color: var(--paper); background: var(--ink); font-size: 0.68rem; letter-spacing: -0.04em; }
	nav { display: flex; align-items: center; gap: clamp(12px, 2.5vw, 30px); }
	nav a { color: var(--ink-soft); font-size: 0.78rem; font-weight: 650; text-decoration: none; }
	nav a[aria-current='page'], nav a:hover { color: var(--ink); }
	.contact-link { padding: 8px 13px; border: 1px solid var(--line); border-radius: 999px; }
	@media (max-width: 620px) {
		.header-inner { min-height: 64px; }
		.wordmark > span:last-child { display: none; }
		nav { gap: 13px; }
		.contact-link { display: none; }
	}
</style>
