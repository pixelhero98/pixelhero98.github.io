---
import { siteConfig } from '../config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="shell footer-grid">
		<div>
			<p class="footer-title">Let’s build generative systems that hold up beyond the demo.</p>
			<a class="email" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
		</div>
		<div class="footer-links">
			<a href={siteConfig.github}>GitHub</a>
			<a href={siteConfig.scholar}>Google Scholar</a>
			<a href={siteConfig.cvPath}>CV</a>
		</div>
	</div>
	<div class="shell footer-meta">
		<span>© {year} {siteConfig.name}</span>
		<span>Built for clarity, speed, and access.</span>
	</div>
</footer>

<style>
	.site-footer { padding: 72px 0 28px; color: var(--paper); background: var(--ink); }
	.footer-grid { display: grid; grid-template-columns: 1.7fr 1fr; gap: 40px; align-items: end; }
	.footer-title { max-width: 720px; margin-bottom: 22px; font-family: var(--serif); font-size: clamp(2rem, 4.5vw, 4.4rem); line-height: 1.05; letter-spacing: -0.035em; }
	.email { color: #a9d0ca; font-size: 0.9rem; }
	.footer-links { display: flex; flex-direction: column; gap: 12px; align-items: flex-end; }
	.footer-links a { color: var(--paper); font-size: 0.82rem; text-decoration: none; }
	.footer-meta { display: flex; justify-content: space-between; gap: 24px; margin-top: 70px; padding-top: 20px; border-top: 1px solid rgba(245, 242, 234, 0.18); color: rgba(245, 242, 234, 0.55); font-size: 0.7rem; }
	@media (max-width: 700px) {
		.footer-grid { grid-template-columns: 1fr; }
		.footer-links { align-items: flex-start; flex-direction: row; flex-wrap: wrap; }
		.footer-meta { flex-direction: column; margin-top: 48px; }
	}
</style>
