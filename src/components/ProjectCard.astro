---
import type { CollectionEntry } from 'astro:content';
import ProjectVisual from './ProjectVisual.astro';

interface Props { project: CollectionEntry<'projects'>; compact?: boolean; }
const { project, compact = false } = Astro.props;
---

<article class:list={['project-card', { compact }]}>
	<a class="visual-link" href={`/work/${project.id}/`} aria-label={`Read the ${project.data.title} case study`}>
		<ProjectVisual type={project.data.visual} label={project.data.status} />
	</a>
	<div class="card-copy">
		<div class="card-meta"><span>{project.data.dates}</span><span>{project.data.status}</span></div>
		<h3><a href={`/work/${project.id}/`}>{project.data.title}</a></h3>
		<p>{project.data.tagline}</p>
		<ul class="tag-list">{project.data.themes.slice(0, compact ? 2 : 3).map((theme) => <li class="tag">{theme}</li>)}</ul>
	</div>
</article>

<style>
	.project-card { min-width: 0; }
	.visual-link { display: block; color: inherit; text-decoration: none; transition: transform 200ms ease; }
	.visual-link:hover { transform: translateY(-4px); }
	.card-copy { padding: 22px 3px 6px; }
	.card-meta { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 12px; color: var(--ink-soft); font-size: .64rem; font-weight: 680; letter-spacing: .1em; text-transform: uppercase; }
	h3 { margin-bottom: 10px; font-size: clamp(1.5rem, 2.8vw, 2.25rem); }
	h3 a { text-decoration: none; }
	p { max-width: 620px; margin-bottom: 18px; color: var(--ink-soft); font-family: var(--serif); font-size: 1.06rem; line-height: 1.48; }
	.compact :global(.visual) { min-height: 190px; }
	.compact h3 { font-size: 1.45rem; }
</style>
