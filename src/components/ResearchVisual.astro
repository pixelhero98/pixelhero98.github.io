---
import {renderDemo,defaults,type DemoId} from '../lib/demos';
interface Props{type:string;}
const {type}=Astro.props;
const numerical=['transport','laplace','capacity','relations','optimization','decoupled'].includes(type);
const plot=numerical?renderDemo(type as DemoId,defaults(type as DemoId)).svg:'';
---
{numerical?<div class="numeric" set:html={plot}/>:<svg viewBox="0 0 300 180" role="img" aria-label={type==='video'?'Synthetic rollout: coherent path and accumulated drift':type==='market'?'Schematic bid and ask levels':'Evidence flowing from sources to a verified answer'}>
{type==='video'&&<>{[0,1,2,3,4].map(i=><g><rect x={12+i*57} y="26" width="49" height="51" rx="3" fill="white" stroke="#dfe5ea"/><circle cx={23+i*57+i*4} cy="53" r="6" fill="#245f91"/><rect x={12+i*57} y="102" width="49" height="51" rx="3" fill="white" stroke="#dfe5ea"/><circle cx={23+i*57+i*4} cy={127+Math.sin(i)*i*5} r={6+i*.6} fill="#8e9aa5"/></g>)}<text x="12" y="16">CONTROLLED PATH</text><text x="12" y="94">ACCUMULATING DRIFT</text><text x="12" y="173">SYNTHETIC ROLLOUT</text></>}
{type==='market'&&<><line x1="150" y1="24" x2="150" y2="147" stroke="#aab5bf"/>{[0,1,2,3,4].map(i=><g><rect x={143-(i+1)*21} y={29+i*23} width={(i+1)*21} height="14" rx="2" fill="#245f91" opacity={1-i*.1}/><rect x="157" y={29+i*23} width={20+(4-i)*17} height="14" rx="2" fill="#91b7d4"/></g>)}<text x="65" y="170">BID</text><text x="202" y="170">ASK</text></>}
{type==='agents'&&<>{[0,1,2].map(i=><g><rect x="20" y={23+i*47} width="58" height="31" rx="3" fill="white" stroke="#91b7d4"/><path d={`M78 ${39+i*47} L137 87`} stroke="#91b7d4" fill="none"/><line x1="31" y1={34+i*47} x2="66" y2={34+i*47} stroke="#aab5bf"/><line x1="31" y1={43+i*47} x2="58" y2={43+i*47} stroke="#aab5bf"/></g>)}<rect x="137" y="66" width="69" height="42" rx="4" fill="#245f91"/><text x="151" y="91" style="fill:white">VERIFY</text><path d="M206 87H227" stroke="#245f91"/><circle cx="247" cy="87" r="20" fill="none" stroke="#245f91"/><path d="M237 87l7 7 12-15" fill="none" stroke="#245f91" stroke-width="2"/><text x="22" y="173">SOURCES → EVIDENCE → ANSWER</text></>}
</svg>}
<style>.numeric{width:100%;height:100%;display:grid;place-items:center}.numeric :global(svg){width:100%;height:100%}.numeric :global(text){display:none}svg{font-family:Inter,system-ui,sans-serif}text{font-size:8px;letter-spacing:.8px;fill:#59636d}</style>
