---
interface Props { type: 'video' | 'clock' | 'laplace' | 'code' | 'graph' | 'market' | 'agents'; label?: string; }
const { type, label } = Astro.props;
---

<div class:list={['visual', `visual--${type}`]} aria-hidden="true">
	<div class="visual-grid"></div>
	{type === 'video' && (
		<div class="filmstrip">
			{[0, 1, 2, 3].map((index) => <span style={`--i:${index}`}></span>)}
			<div class="path-line"></div>
		</div>
	)}
	{type === 'clock' && (
		<div class="clock-face">
			<span class="ring ring--one"></span><span class="ring ring--two"></span>
			{[0, 1, 2, 3, 4, 5].map((index) => <i style={`--i:${index}`}></i>)}
			<b></b>
		</div>
	)}
	{type === 'laplace' && (
		<div class="modes">
			{[0, 1, 2, 3, 4, 5, 6].map((index) => <span style={`--i:${index}`}></span>)}
		</div>
	)}
	{type === 'code' && <div class="code-lines">{[0, 1, 2, 3, 4].map((index) => <span style={`--i:${index}`}></span>)}</div>}
	{type === 'graph' && <div class="nodes">{[0, 1, 2, 3, 4, 5].map((index) => <span style={`--i:${index}`}></span>)}</div>}
	{type === 'market' && <div class="market-bars">{[0, 1, 2, 3, 4, 5, 6].map((index) => <span style={`--i:${index}`}></span>)}</div>}
	{type === 'agents' && <div class="agent-grid">{['Plan', 'Quant', 'Evidence', 'Verify'].map((item, index) => <span style={`--i:${index}`}>{item}</span>)}</div>}
	{label && <small>{label}</small>}
</div>

<style>
	.visual { position: relative; min-height: 270px; overflow: hidden; border: 1px solid var(--line); border-radius: 22px; background: var(--paper-deep); isolation: isolate; }
	.visual-grid { position: absolute; inset: 0; opacity: .35; background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: 28px 28px; }
	.visual small { position: absolute; left: 18px; bottom: 14px; z-index: 3; color: var(--ink-soft); font-size: .62rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
	.filmstrip { position: absolute; inset: 48px 34px 58px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
	.filmstrip span { border-radius: 10px; background: linear-gradient(155deg, rgba(43,122,120,.18), rgba(18,58,74,.94)); transform: translateY(calc(var(--i) * 7px)); }
	.filmstrip span::before { content: ''; display: block; width: 28%; height: 42%; margin: 30% auto; border: 1px solid rgba(245,242,234,.8); border-radius: 50% 50% 35% 65%; transform: translateX(calc((var(--i) - 1.5) * 6px)); }
	.path-line { position: absolute; left: 8%; right: 4%; bottom: -18px; height: 38px; border-top: 2px solid var(--warm); border-radius: 50%; transform: rotate(-3deg); }
	.clock-face { position: absolute; width: 190px; aspect-ratio: 1; left: 50%; top: 50%; transform: translate(-50%,-50%); border: 1px solid var(--navy); border-radius: 50%; }
	.ring { position: absolute; border: 1px solid rgba(43,122,120,.5); border-radius: 50%; }
	.ring--one { inset: 22px; } .ring--two { inset: 52px; }
	.clock-face i { position: absolute; width: 10px; aspect-ratio: 1; left: calc(50% + cos(calc(var(--i) * 60deg)) * 78px); top: calc(50% + sin(calc(var(--i) * 60deg)) * 78px); border-radius: 50%; background: var(--teal); transform: translate(-50%,-50%); }
	.clock-face b { position: absolute; left: 50%; top: 50%; width: 45%; height: 2px; background: var(--warm); transform-origin: left; animation: sweep 8s linear infinite; }
	.modes { position: absolute; inset: 58px 38px; display: flex; align-items: center; justify-content: center; gap: 12px; }
	.modes span { width: 14px; height: calc(42px + var(--i) * 13px); max-height: 150px; border-radius: 99px; background: linear-gradient(var(--teal), var(--navy)); transform: translateY(calc((var(--i) - 3) * 3px)); opacity: calc(.45 + var(--i) * .07); }
	.code-lines { position: absolute; inset: 56px 42px; display: flex; flex-direction: column; gap: 15px; }
	.code-lines span { width: calc(42% + var(--i) * 9%); height: 11px; max-width: 90%; border-radius: 99px; background: var(--navy); opacity: calc(.25 + var(--i) * .1); }
	.nodes { position: absolute; inset: 0; }
	.nodes span { position: absolute; left: calc(18% + (var(--i) % 3) * 31%); top: calc(23% + (var(--i) % 2) * 45%); width: calc(24px + var(--i) * 2px); aspect-ratio: 1; border-radius: 50%; background: var(--teal); box-shadow: 0 0 0 12px rgba(43,122,120,.1), calc((2 - var(--i)) * 22px) calc((var(--i) - 2) * 18px) 0 -10px var(--navy); }
	.market-bars { position: absolute; inset: 50px 42px; display: flex; align-items: end; gap: 12px; }
	.market-bars span { flex: 1; height: calc(32% + (var(--i) % 4) * 17%); background: var(--navy); opacity: calc(.35 + var(--i) * .07); border-radius: 5px 5px 0 0; }
	.agent-grid { position: absolute; inset: 48px 28px; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
	.agent-grid span { display: grid; place-items: center; border: 1px solid rgba(18,58,74,.35); border-radius: 12px; color: var(--navy); background: rgba(245,242,234,.7); font-size: .68rem; font-weight: 700; text-transform: uppercase; }
	@keyframes sweep { to { transform: rotate(360deg); } }
</style>
