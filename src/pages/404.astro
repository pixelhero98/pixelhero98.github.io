---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="The requested page could not be found.">
	<section class="section missing"><div class="shell"><p class="eyebrow">404</p><h1>This path<br /><span class="serif">doesn’t resolve.</span></h1><p class="lede">The page may have moved, or the research path has not been published yet.</p><a class="button button--primary" href="/">Return home</a></div></section>
</BaseLayout>
<style>.missing { min-height: 66vh; display: grid; align-items: center; }.missing .button { margin-top: 18px; }</style>
