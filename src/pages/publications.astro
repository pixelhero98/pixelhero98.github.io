---
import {getCollection} from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationRow from '../components/PublicationRow.astro';
import {researchItems} from '../lib/research';
const publications=(await getCollection('publications')).sort((a,b)=>b.data.year-a.data.year||a.data.title.localeCompare(b.data.title));
const items=await researchItems();
const jsonLd=publications.map(p=>({'@context':'https://schema.org','@type':'ScholarlyArticle',headline:p.data.title,author:p.data.authors.map(name=>({'@type':'Person',name})),datePublished:String(p.data.year),isPartOf:{'@type':'PublicationVolume',name:p.data.venue},url:p.data.links.find(l=>l.label==='Paper')?.url}));
---
<BaseLayout title="Publications" jsonLd={jsonLd}><div class="shell"><header class="page-heading"><h1>Publications</h1><p>Papers on generative modelling, graph representation learning, and optimization.</p></header>{publications.map(publication=><PublicationRow publication={publication} projectId={items.find(item=>item.publications.some(p=>p.id===publication.id))?.project.id}/>)}</div></BaseLayout>
