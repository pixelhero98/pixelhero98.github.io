---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const { Content } = await render(project);
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'CreativeWork',
	name: project.data.title,
	description: project.data.tagline,
	author: { '@type': 'Person', name: 'Zinuo You' },
	url: new URL(`/work/${project.id}/`, 'https://zinuoyou.com').href,
};
---

<BaseLayout title={project.data.title} description={project.data.tagline} article jsonLd={jsonLd}>
	<header class="case-hero section--compact">
		<div class="shell">
			<a class="back" href="/work/">← All work</a>
			<div class="case-grid">
				<div>
					<div class="case-meta"><span>{project.data.status}</span><span>{project.data.dates}</span></div>
					<h1>{project.data.title}</h1>
					<p class="lede">{project.data.tagline}</p>
					<ul class="tag-list">{project.data.themes.map((theme) => <li class="tag">{theme}</li>)}</ul>
				</div>
				<ProjectVisual type={project.data.visual} label="Research system" />
			</div>
		</div>
	</header>

	<section class="section--compact section--tint">
		<div class="shell brief-grid">
			<div><p class="brief-label">Problem</p><p>{project.data.problem}</p></div>
			<div><p class="brief-label">Approach</p><p>{project.data.approach}</p></div>
			<div><p class="brief-label">Role</p><p>{project.data.role}</p></div>
		</div>
	</section>

	<section class="section--compact">
		<div class="shell article-grid">
			<article class="prose"><Content /></article>
			<aside>
				<div class="aside-block"><p class="brief-label">Evidence</p><ul>{project.data.evidence.map((item) => <li>{item}</li>)}</ul></div>
				{project.data.links.length > 0 && <div class="aside-block"><p class="brief-label">Links</p>{project.data.links.map((link) => <a class="aside-link" href={link.url}>{link.label} <span aria-hidden="true">↗</span></a>)}</div>}
				{project.data.disclosure && <div class="disclosure"><strong>Disclosure</strong><p>{project.data.disclosure}</p></div>}
			</aside>
		</div>
	</section>
</BaseLayout>

<style>
	.back { display: inline-block; margin-bottom: 42px; color: var(--ink-soft); font-size: .75rem; font-weight: 700; text-decoration: none; }
	.case-grid { display: grid; grid-template-columns: 1fr .8fr; gap: clamp(34px, 7vw, 96px); align-items: center; }
	.case-meta { display: flex; gap: 16px; margin-bottom: 18px; color: var(--teal); font-size: .7rem; font-weight: 750; letter-spacing: .12em; text-transform: uppercase; }
	.case-grid h1 { margin-bottom: 22px; font-size: clamp(3rem, 6vw, 6.5rem); }
	.case-grid .lede { margin-bottom: 24px; }
	.brief-grid { display: grid; grid-template-columns: 1fr 1fr .7fr; gap: 34px; }
	.brief-grid > div { padding-right: 24px; border-right: 1px solid var(--line); }
	.brief-grid > div:last-child { border-right: 0; }
	.brief-grid p:last-child { margin: 0; color: var(--ink-soft); font-family: var(--serif); font-size: 1.05rem; }
	.brief-label { margin-bottom: 10px; color: var(--teal); font-size: .64rem; font-weight: 780; letter-spacing: .12em; text-transform: uppercase; }
	.article-grid { display: grid; grid-template-columns: minmax(0, 1fr) 330px; gap: clamp(48px, 9vw, 120px); align-items: start; }
	aside { position: sticky; top: 110px; }
	.aside-block { padding: 22px 0; border-top: 1px solid var(--line); }
	.aside-block ul { padding-left: 18px; color: var(--ink-soft); font-size: .82rem; }
	.aside-block li + li { margin-top: 10px; }
	.aside-link { display: block; padding: 7px 0; color: var(--navy); font-size: .76rem; font-weight: 700; text-decoration: none; }
	.disclosure { margin-top: 18px; padding: 18px; border-left: 3px solid var(--warm); background: rgba(182,95,58,.08); font-size: .76rem; }
	.disclosure p { margin: 8px 0 0; color: var(--ink-soft); }
	@media (max-width: 850px) { .case-grid, .article-grid { grid-template-columns: 1fr; } aside { position: static; } .brief-grid { grid-template-columns: 1fr; } .brief-grid > div { padding: 0 0 22px; border-right: 0; border-bottom: 1px solid var(--line); } }
</style>
