---
import {render} from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Demo from '../../components/Demo.astro';
import ResearchVisual from '../../components/ResearchVisual.astro';
import {researchItems,researchLinks,type ResearchItem} from '../../lib/research';
import {siteConfig} from '../../config';
export async function getStaticPaths(){return(await researchItems()).map(item=>({params:{id:item.project.id},props:{item}}));}
interface Props{item:ResearchItem;}
const {item}=Astro.props;const {project,publications}=item;const primary=publications[0]?.data;
const title=primary?.title??project.data.title;const {Content}=await render(project);
const jsonLd={'@context':'https://schema.org','@type':primary?'ScholarlyArticle':'CreativeWork',name:title,description:project.data.summary,author:(primary?.authors??['Zinuo You']).map(name=>({'@type':'Person',name})),url:new URL(`/work/${project.id}/`,siteConfig.domain).href};
---
<BaseLayout title={project.data.shortTitle} description={project.data.summary} article jsonLd={jsonLd}><div class="shell">
<header class="paper-header"><a class="back" href="/#featured">← Research overview</a><h1>{title}</h1>
{primary&&<div class="authors">{primary.authors.map((name,i)=><>{i?', ':''}{name==='Zinuo You'?<strong>{name}</strong>:name}</>)}</div>}
<div class="meta">{primary?.venue??project.data.status}{primary?.highlight&&<> · <span class="highlight">{primary.highlight}</span></>}</div>
<p class="summary">{project.data.summary}</p><div class="links">{researchLinks(item).map(link=><a href={link.url}>{link.label} ↗</a>)}{project.data.demo&&<a href="#demo">Try the toy experiment ↓</a>}</div></header>
<div class="paper-details">{project.data.role} · {project.data.dates}</div>
{!project.data.demo&&<figure class="project-illustration"><ResearchVisual type={project.data.visual}/><figcaption>Schematic illustration · {project.data.visual==='video'?'Not generated video or measured research results.':'Not a model output.'}</figcaption></figure>}
<article class="prose"><Content/></article>{project.data.demo&&<Demo id={project.data.demo}/>}
{publications.length>1&&<section class="prose"><h2>Extended publication</h2>{publications.slice(1).map(p=><p><a href={p.data.links.find(l=>l.label==='Paper')?.url}>{p.data.title}</a><br/><span class="meta">{p.data.venue}</span></p>)}</section>}
</div></BaseLayout>
<style>.project-illustration{margin:24px 0;max-width:580px;padding:20px;background:var(--wash);border:1px solid var(--line);border-radius:5px}.project-illustration :global(svg){width:100%;height:auto}.project-illustration figcaption{font-size:.73rem;color:var(--muted);margin-top:12px}</style>
