---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResearchRow from '../../components/ResearchRow.astro';
import {researchItems} from '../../lib/research';
const items=await researchItems();
---
<BaseLayout title="Research & projects"><div class="shell"><header class="page-heading"><h1>Research & projects</h1><p>Generative modelling, graph learning, and optimization. Explore the ideas through small, interactive synthetic experiments.</p></header>{items.map(item=><ResearchRow item={item}/>)}</div></BaseLayout>
