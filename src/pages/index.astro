---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchRow from '../components/ResearchRow.astro';
import Experience from '../components/Experience.astro';
import {researchItems} from '../lib/research';
import {siteConfig as site} from '../config';
const items=await researchItems();
const groups=[{id:'featured',title:'Selected research'},{id:'papers',title:'More papers'},{id:'projects',title:'Projects'}];
---
<BaseLayout><div class="shell"><section class="intro" aria-labelledby="name">
<h1 id="name">Zinuo <span style="font-weight:400">(Henry)</span> You</h1><p class="affiliation">PhD researcher · University of Bristol</p>
<p>I work on <strong>generative modelling, sequence modelling, and reinforcement learning</strong>. My research explores how to generate coherent sequences over long horizons, improve generative models through reinforcement learning and distillation, and make inference more efficient.</p>
<p>I am pursuing a PhD in Engineering Mathematics and Computer Science. My earlier work studies graph representation learning and Bayesian optimization.</p>
<div class="links"><a href={`mailto:${site.email}`}>Email</a><a href={site.scholar}>Google Scholar</a><a href={site.github}>GitHub</a><a href={site.cvPath}>CV ↓</a></div></section>
{groups.map(group=><section id={group.id} class="section" aria-labelledby={group.id+'-heading'}>
<div class="section-heading"><h2 id={group.id+'-heading'}>{group.title}</h2>{group.id==='papers'&&<a href="/publications/">All publications ↗</a>}{group.id==='featured'&&<span class="meta">Ideas, methods & interactive explanations</span>}</div>
{items.filter(item=>item.project.data.group===group.id).map(item=><ResearchRow item={item}/>)}</section>)}
<Experience/></div></BaseLayout>
